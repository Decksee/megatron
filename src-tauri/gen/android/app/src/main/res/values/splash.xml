<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage : icône Mégatron sur le fond de l'appli (clair ou sombre). -->
<resources>
    <color name="splash_bg">#FFF7F7F9</color>
    <style name="Theme.megatron.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.megatron</item>
    </style>
</resources>
