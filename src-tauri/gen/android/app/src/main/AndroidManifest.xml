<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications (tâche en cours, rappels, point du matin). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Remettre les alarmes après un redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Rappels à la minute près (application de rappels). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Parler à l'assistant (le micro n'est ouvert que pendant la dictée). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Petite vibration au toucher. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Guide : demander de ne pas mettre Mégatron en veille (rappels et widgets appli fermée). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Blocage d'applis pendant un focus : voir l'appli ouverte et poser l'écran « Focus en cours » devant. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Liste des applis installées (choisir celles à bloquer pendant un focus). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.megatron"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:theme="@style/Theme.megatron.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".ActionReceiver" android:exported="false" />
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".FocusReceiver" android:exported="false" />
        <receiver android:name=".TimerReceiver" android:exported="false" />
        <!-- Blocage d'applis pendant un focus (seulement pendant le focus, avec la notification du compte à rebours). -->
        <service
            android:name=".FocusWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Blocage des applis choisies par l'utilisateur pendant une session de focus" />
        </service>
        <activity
            android:name=".BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.megatron.block"
            android:theme="@style/Theme.megatron" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Widget « Aujourd'hui » de l'écran d'accueil. -->
        <receiver android:name=".WidgetProvider" android:exported="true" android:label="Mégatron · Aujourd'hui">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".FocusWidgetProvider" android:exported="true" android:label="Mégatron · Focus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_focus_info" />
        </receiver>
        <receiver android:name=".ReminderWidgetProvider" android:exported="true" android:label="Mégatron · Prochain rappel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_reminder_info" />
        </receiver>
        <receiver android:name=".TimerWidgetProvider" android:exported="true" android:label="Mégatron · Minuteur">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timer_info" />
        </receiver>
        <receiver android:name=".QuickWidgetProvider" android:exported="true" android:label="Mégatron · Ajout rapide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver android:name=".MoneyWidgetProvider" android:exported="true" android:label="Mégatron · Argent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_money_info" />
        </receiver>
        <receiver android:name=".WeekWidgetProvider" android:exported="true" android:label="Mégatron · Ma semaine">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week_info" />
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
